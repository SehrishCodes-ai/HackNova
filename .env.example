# ============================================================================
# ScholarBridge Environment Configuration (.env.example)
# Copy to .env and configure your environment-specific values.
# NEVER commit .env to version control.
# ============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (Neon Cloud PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Authentication Secret:
# Must be a cryptographically random 256-bit (32-byte) string.
# To generate one securely on your machine, run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional external service keys
GEMINI_API_KEY=
APP_URL=http://localhost:3000
